# security headers, every response
#
# THE CSP NOW NAMES WHERE SCRIPT MAY COME FROM. It used to carry only
# frame-ancestors/object-src/base-uri, with a note saying a real script-src
# "breaks adsense, gtm, razorpay". That was true of a script-src 'self' — and
# the answer to that is an allowlist, not an absent directive. Without one,
# any script that reaches the page may load any other script from anywhere and
# talk to anywhere, which is precisely the shape of a crypto-miner injection:
# a miner is a script from a host you have never heard of plus a socket to a
# pool. Both halves are now refused by name.
#
# WHAT EACH NON-OBVIOUS ENTRY IS FOR — do not prune these without checking:
#   blob: in script-src   js/sections.js:3762 and js/gallery.js:1395 fetch the
#                         store and ops modules as TEXT and run them from a
#                         Blob URL. Drop blob: and checkout and the ops panel
#                         stop loading. It is NOT a leftover.
#   'unsafe-inline'       index.html carries three inline <script> blocks and
#                         inline handlers. Removing it needs per-request
#                         nonces, which a static _headers file cannot mint —
#                         functions/_middleware.js would have to inject them.
#                         Worth doing later; it is the one real gap left here.
#   googlesyndication /   AdSense, which loads a tree of Google ad hosts at
#   doubleclick /         runtime. js/effects.js:82 is the entry point.
#   adtrafficquality
#   generativelanguage    the Zeo assistant calls Gemini directly.
#
# ROLLING IT BACK is one edit: delete the Content-Security-Policy line. Nothing
# else in the file depends on it.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), magnetometer=(), payment=(self "https://checkout.razorpay.com" "https://www.paypal.com"), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://adservice.google.com https://checkout.razorpay.com https://*.razorpay.com https://www.paypal.com https://*.paypal.com https://*.paypalobjects.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://tmqzqlrpjpydiftlrzmj.supabase.co; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' blob: https://tmqzqlrpjpydiftlrzmj.supabase.co wss://tmqzqlrpjpydiftlrzmj.supabase.co https://generativelanguage.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://api.razorpay.com https://*.razorpay.com https://*.paypal.com; frame-src 'self' https://*.paypal.com https://*.razorpay.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; form-action 'self' https://*.razorpay.com https://*.paypal.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache

# Scripts and stylesheets. Every reference to one of these carries ?v=<n> —
# index.html is the authority for the numbers and scripts/check-precache.mjs
# fails the build if a reference is missing its version or disagrees with the
# service worker. That enforcement is what makes a year and `immutable` correct
# here: a release changes the URL, so this copy can never be the wrong one, and
# the browser is told it need not even ask.
#
# The unversioned path (/js/app-core.js with no query) gets the same header and
# is not referenced by anything, so nothing can pin content that changes.
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# Runtime configuration, deliberately unversioned so a key can be rotated
# without a deploy. Short, and revalidated.
/config.js
  Cache-Control: public, max-age=300, must-revalidate

# Icons and the touch icon. A week, and index.html carries a ?v= on every one
# of them, so a mark that changes reaches a returning visitor on the deploy
# rather than whenever their week happens to be up. Rules here match on the
# path, so the query string does not need repeating.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=604800
/logo.svg
  Cache-Control: public, max-age=604800
/zeo-avatar.png
  Cache-Control: public, max-age=604800

# The manifest and the crawler files are checked often enough to be worth an
# hour and no more. Never immutable: nothing in their URL says which copy this
# is, and a pinned manifest is a pinned app identity.
/site.webmanifest
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/ads.txt
  Cache-Control: public, max-age=3600
# The IndexNow ownership key. Bing, Yandex, Seznam and Naver fetch this back
# to prove a submission came from whoever runs the domain, so it has to stay
# reachable and has to keep saying the same thing — see scripts/indexnow.mjs.
# Not a secret: the protocol works by publishing it.
/8968b78d9c9d0df0553bf47f2e121021.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# The HTML, spelled out rather than left to a platform default.
#
# index.html is the one file that says which bundles are current, so it is the
# one file that must never be answered from a cache without asking. Everything
# above depends on that: /js/* and /css/* are pinned for a year precisely
# BECAUSE the HTML pointing at them is always revalidated, and a release that
# could not update the HTML would be a release nobody receives.
#
# Every path here resolves to index.html — the artwork link, the four section
# links, the profile link and /login are SPA fallbacks in _redirects, and a
# header rule matches the path that was REQUESTED, not the file that answers
# it, so each one needs saying. Keep this list and _redirects in step: a path
# listed here with no fallback there is a 404 wearing a cache policy, which is
# exactly what /profile/* was.
# must-revalidate rather than no-store: the browser may keep its copy, it just
# may not use it without checking.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/artwork/*
  Cache-Control: public, max-age=0, must-revalidate
/resource/*
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
/listing/*
  Cache-Control: public, max-age=0, must-revalidate
/job/*
  Cache-Control: public, max-age=0, must-revalidate
/profile/*
  Cache-Control: public, max-age=0, must-revalidate
/login
  Cache-Control: public, max-age=0, must-revalidate
/explore
  Cache-Control: public, max-age=0, must-revalidate
/marketplace
  Cache-Control: public, max-age=0, must-revalidate
/resources
  Cache-Control: public, max-age=0, must-revalidate
/blog
  Cache-Control: public, max-age=0, must-revalidate
/community
  Cache-Control: public, max-age=0, must-revalidate

# Pages Functions answer per caller, behind a session check. Nothing here may
# be held by a browser cache, a shared cache or a crawler — a stored copy is a
# signed-in answer waiting to be handed to whoever asks next. The functions set
# these themselves; this is the second lock.
/api/*
  Cache-Control: no-store, private, max-age=0
  X-Robots-Tag: noindex, nofollow
  Vary: Authorization
