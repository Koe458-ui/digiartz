# security headers, every response
# no strict script-src: breaks adsense, gtm, razorpay
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), magnetometer=()
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache

# Pages Functions answer per caller, behind a session check. Nothing here may
# be held by a browser cache, a shared cache or a crawler — a stored copy is a
# signed-in answer waiting to be handed to whoever asks next. The functions set
# these themselves; this is the second lock.
/api/*
  Cache-Control: no-store, private, max-age=0
  X-Robots-Tag: noindex, nofollow
  Vary: Authorization
